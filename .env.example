# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Instant Deployment Readiness)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file containing secrets to version control.

# 🧠 Perceptio Neuro Labs - BCI & EEG Engine
PERCEPTIO_API_PORT=8000
PERCEPTIO_LOG_LEVEL=info
EEG_SIGNAL_MOCK_MODE=true # Set to false when connecting to hardware

# 👁️ IrisVerify & IrisVault Biometrics
VITE_BIOMETRIC_ACCURACY_THRESHOLD=0.92
VITE_ENABLE_WEBCAM_SCANNING=true

# 🤖 Inkanto AI Assistant & Sovereign Intel Terminal
# OpenAI API Key for Chatbot & Assistant Models
OPENAI_API_KEY=your_openai_api_key_here
# Supabase Configuration for Sovereign Intel Terminal Database
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# 🗣️ Sovereign Terminal Voice Integration
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ☁️ Infrastructure & AWS Deployment (ClusterLaunch)
TF_VAR_allowed_cidr=your_operator_public_ip_in_cidr_format # e.g., 8.8.8.8/32
TF_VAR_key_name=your_aws_ssh_key_name
TF_VAR_enable_public_demo=true
