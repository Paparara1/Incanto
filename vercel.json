{
  "version": 2,
  "name": "incanto-vibe-coder",
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "irisvault/**",
      "use": "@vercel/static"
    },
    {
      "src": "kobalt-html/**",
      "use": "@vercel/static"
    },
    {
      "src": "asi-bridge/**",
      "use": "@vercel/static"
    },
    {
      "src": "vibe-coder/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/intent",
      "dest": "/api/intent.js"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/irisvault/(.*)",
      "dest": "/irisvault/$1"
    },
    {
      "src": "/kobalt/(.*)",
      "dest": "/kobalt-html/$1"
    },
    {
      "src": "/asi/(.*)",
      "dest": "/asi-bridge/$1"
    },
    {
      "src": "/vibe-coder/(.*)",
      "dest": "/vibe-coder/$1"
    },
    {
      "src": "/vibe/(.*)",
      "dest": "/vibe-coder/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
